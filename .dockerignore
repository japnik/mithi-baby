# Version Control
.git/
.gitignore
.dockerignore

# Python
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Environment Variables
.env
.env.*
!.env.example
backend/auth/client_secrets.json
backend/auth/token.pickle

# User Data & Large Media (Explicitly target backend folders)
backend/videos/
backend/audios/
backend/lyrics/
backend/temp/
backend/temp_gen_*/
backend/api_logs/

# Avoid large media files generally
**/*.mp4
**/*.mp3
**/*.wav
**/*.jpg

# Handle PNGs carefully:
# Do NOT use a global *.png (it's too risky for our logo)
# Instead, ignore pngs only where they are generated/large
backend/**/*.png
test_pil.png

# OS & IDEs
.DS_Store
.vscode/
.idea/
